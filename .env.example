# Posture Monitor Demo Backend - Environment Configuration Template
# Copy this file to `.env` (`cp .env.example .env`) and adjust if needed.

# Django secret key (change in production; safe default exists for school demo)
DJANGO_SECRET_KEY=replace-me-with-a-secret-key

# Enable Django debug mode (True / False)
DEBUG=True

# Comma-separated list of allowed hosts/IPs (use * to allow any device on the local router)
ALLOWED_HOSTS=*